<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PiedonianCivicDocument</AssemblyName>
    <RootNamespace>PiedonianCivicDocument</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Piedonian Woods</Authors>
    <Description>Standalone Windows 11 civic document application combining the Constitution and Signature Packet with electronic signing.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- True single-file EXE: UI + documents are embedded; only signature data is written beside the EXE. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev/run convenience copies -->
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- Embedded so published single-file EXE is fully standalone -->
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>assets.wwwroot.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Content\**\*">
      <LogicalName>assets.Content.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
